{
  "name": "wird-app",
  "version": "1.0.0",
  "description": "WIRD — mémorisation et révision du Coran (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-data.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/flows.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnny-gms/Wird-app.git"
  },
  "bugs": {
    "url": "https://github.com/johnny-gms/Wird-app/issues"
  },
  "homepage": "https://github.com/johnny-gms/Wird-app#readme",
  "dependencies": {
    "@fontsource/amiri-quran": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.32",
    "quran-json": "^3.1.2",
    "quran-meta": "^7.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "web-push": "^4.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "private": true,
  "type": "module"
}
