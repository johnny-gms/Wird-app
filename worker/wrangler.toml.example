# Copier vers worker/wrangler.toml puis adapter (le vrai fichier est ignoré par git). Voir docs/NOTIFICATIONS.md.
name = "wird-push"
main = "src/index.ts"
compatibility_date = "2025-01-01"

[[d1_databases]]
binding = "DB"
database_name = "wird-push"
database_id = "<ID affiché par `npx wrangler d1 create wird-push`>"

[triggers]
# Toutes les 15 minutes : le Worker évalue, pour chaque abonné, quels rappels sont dus dans son fuseau horaire.
crons = ["*/15 * * * *"]

[vars]
ALLOWED_ORIGIN = "https://<adresse exacte de ton app>"   # origine autorisée (CORS), sans / final
VAPID_SUBJECT = "mailto:<ton adresse de contact>"        # exigé par les services Push (Apple, Google, Mozilla)

# Secrets (jamais dans ce fichier) :
#   npx wrangler secret put VAPID_PUBLIC_KEY
#   npx wrangler secret put VAPID_PRIVATE_KEY
